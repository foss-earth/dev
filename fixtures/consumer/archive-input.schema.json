{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev exact owner/compiler/jsdom closure archive input",
  "type": "object",
  "required": [
    "schemaVersion",
    "planSha256",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "archive",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "archive": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "description": "The executable harness additionally verifies the exact complete dependency-plan names/versions/required metadata, local retained archive containment/digests/contents, current candidate output, and isolation negative controls. This schema alone is not admission."
}
