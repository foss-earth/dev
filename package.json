{
  "name": "@foss-earth/dev",
  "version": "0.1.0",
  "private": true,
  "description": "Explicit dev=1 activation and host-owned diagnostic view lifecycle",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "./styles/panel.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./panel.css": "./styles/panel.css"
  },
  "files": [
    "dist",
    "styles",
    "LICENSE",
    "AGENTS.md",
    "README.md",
    "docs",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "test": "vitest run --maxWorkers=50%",
    "ci": "npm run check:implementation",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "check:implementation": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.6",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "typescript-eslint": "8.59.3",
    "globals": "17.6.0"
  }
}
